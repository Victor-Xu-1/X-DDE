  "cases": [
    {
      "id": "brd4-jq1",
      "revision": 1,
      "label": [
        "BRD4–JQ1 结合口袋与先导探索",
        "BRD4–JQ1 pocket and lead exploration"
      ],
      "files": [
        "brd4",
        "jq1",
        "brd4_apo"
      ],
      "sources": [
        "https://www.rcsb.org/structure/3MXF",
        "https://doi.org/10.1038/nature09504",
        "https://www.rcsb.org/structure/4LYI"
      ],
      "description": [
        "使用人 BRD4 第一溴结构域与 JQ1 的实验复合物，准备受体、寻找口袋、检查姿势，再进行分子探索。",
        "Prepare the human BRD4 first bromodomain/JQ1 experimental complex, locate its pocket, evaluate poses and explore molecules."
      ],
      "evidence_entities": {
        "disease": {
          "name": "nut midline carcinoma",
          "description": "A rare, highly aggressive and lethal carcinoma that affects children and young adults. It arises from midline epithelial structures, most commonly the head, neck, and mediastinum. It is a poorly differentiated carcinoma and is characterized by mutations and rearrangement of the NUT gene. A balanced translocation t(15;19) is present that results in the creation of a fusion gene involving the NUT gene, most commonly BRD4-NUT fusion gene.",
          "id": "MONDO_0005563"
        },
        "target": {
          "name": "BRD4",
          "description": "bromodomain containing 4",
          "id": "ENSG00000141867"
        }
      }
    },
    {
      "id": "trastuzumab-her2",
      "revision": 1,
      "label": [
        "曲妥珠单抗–HER2 抗体研究",
        "Trastuzumab–HER2 antibody research"
      ],
      "files": [
        "her2",
        "her2_pertuzumab",
        "trastuzumab_fv"
      ],
      "sources": [
        "https://www.rcsb.org/structure/1N8Z",
        "https://doi.org/10.1038/nature01392",
        "https://www.rcsb.org/structure/1S78",
        "https://www.rcsb.org/structure/1FVC"
      ],
      "description": [
        "使用真实 Fab–HER2 复合物和公开重、轻链序列；先识别可变域，再进行编号、参考评估与结构分析。",
        "Use the real Fab–HER2 complex and published heavy/light chains; identify variable domains before numbering, reference evaluation and structural analysis."
      ]
    },
    {
      "id": "abl-inhibitors",
      "revision": 1,
      "label": [
        "ABL 抑制剂系列性质比较",
        "ABL inhibitor property comparison"
      ],
      "files": [
        "imatinib",
        "dasatinib",
        "nilotinib"
      ],
      "sources": [
        "https://www.ebi.ac.uk/chembl/explore/compound/CHEMBL941",
        "https://www.ebi.ac.uk/chembl/explore/compound/CHEMBL1421",
        "https://www.ebi.ac.uk/chembl/explore/compound/CHEMBL255863"
      ],
      "description": [
        "比较伊马替尼、达沙替尼和尼洛替尼的分子结构、描述符和模型预测，保留化合物记录与单位。",
        "Compare imatinib, dasatinib and nilotinib structures, descriptors and model predictions with compound identity and units."
      ]
    },
    {
      "id": "mz1-ternary",
      "revision": 1,
      "label": [
        "MZ1–BRD4–VHL 双功能分子体系",
        "MZ1–BRD4–VHL bifunctional complex"
      ],
      "files": [
        "mz1",
        "mz1_molecule"
      ],
      "sources": [
        "https://www.rcsb.org/structure/5T35",
        "https://doi.org/10.1038/nchembio.2329"
      ],
      "description": [
        "在真实 PROTAC 三元复合物中检查两个结合端、连接区、蛋白接触与复用关系。",
        "Inspect both binding ends, linker, protein contacts and asset relationships in a real PROTAC ternary complex."
      ]
    },
    {
      "id": "tpp-riboswitch",
      "revision": 1,
      "label": [
        "RNA–TPP 识别复合物",
        "RNA–TPP recognition complex"
      ],
      "files": [
        "rna"
      ],
      "sources": [
        "https://www.rcsb.org/structure/2GDI",
        "https://doi.org/10.1038/nature04740"
      ],
      "description": [
        "公开 RNA–配体结构参考，用于核酸输入和结构预览；该体系不标记为已批准的 RNA 药物。",
        "A public RNA/ligand structural reference for nucleic-acid input and visualization; not labeled as an approved RNA drug."
      ]
    },
    {
      "id": "her2-repebody",
      "revision": 1,
      "label": [
        "HER2 结构域 IV–Rb-H2 蛋白结合体研究",
        "HER2 domain IV–Rb-H2 protein binder research"
      ],
      "description": [
        "使用 6LBX 完整沉积蛋白序列（Rb-H2 275 aa、HER2 构建体 97 aa），预测双蛋白复合物并比较原生预测姿势；不把构建体当成完整 HER2，也不把模型评分当成实测亲和力。",
        "Use the complete deposited 6LBX protein sequences (275-aa Rb-H2 and 97-aa HER2 construct), predict the protein complex and compare native predicted poses. The construct is not full-length HER2; model scores are not measured affinity."
      ],
      "files": [
        "her2_domain_iv"
      ],
      "sources": [
        "https://www.rcsb.org/structure/6LBX",
        "https://doi.org/10.1016/j.csbj.2021.02.013"
      ]
    },
    {
      "id": "trastuzumab-domainiv",
      "revision": 1,
      "label": [
        "曲妥珠单抗–HER2 设计向导",
        "Trastuzumab–HER2 design workflow"
      ],
      "description": [
        "重、轻链复用真实 ANARCII 可变域与 CDR 标注；靶标使用 6LBX 完整沉积的 97 aa HER2 构建体。配置已通过原生校验；对话模型由用户配置后才执行代理设计。",
        "Reuse actual ANARCII variable domains and CDR annotations, with the complete deposited 97-aa HER2 construct from 6LBX. Native configuration validation is retained; agent design requires the user-configured language model."
      ],
      "files": [
        "her2",
        "her2_domain_iv"
      ],
      "sources": [
        "https://www.rcsb.org/structure/1N8Z",
        "https://www.rcsb.org/structure/6LBX",
        "https://doi.org/10.1038/nature01392"
      ]
    }
  ],
