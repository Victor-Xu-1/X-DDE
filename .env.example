# Copy to .env and replace the paths with your local OpenDDE installation.
# The app listens only on 127.0.0.1:4320. No model-service key is needed.
WB_STATE_DIR=/opt/opendde/data/workbench
WB_IMAGE_FILE=/opt/opendde/image-reference.txt
WB_CODE_FILE=/opt/opendde/runtime-code-reference.txt
WB_MODEL_DIR=/opt/opendde/data/opendde
WB_CACHE_DIR=/opt/opendde/cache/gpu
WB_CAPACITY_DIR=/opt/opendde/data
WB_ALLOWED_ORIGINS=http://127.0.0.1:4320,http://localhost:4320
