# X-DDE platform server and independent scientific engine configuration.
# Copy to .env; never commit real credentials.
# The app binds127.0.0.1:4320. Use SSH forwarding for a remote server.
WB_STATE_DIR=/opt/opendde/data/workbench
# OpenDDE adapter only; these paths are not prerequisites for other engines.
WB_IMAGE_FILE=/opt/opendde/image-reference.txt
WB_CODE_FILE=/opt/opendde/runtime-code-reference.txt
WB_MODEL_DIR=/opt/opendde/data/opendde
WB_CACHE_DIR=/opt/opendde/cache/gpu
WB_CAPACITY_DIR=/opt/opendde/data
WB_ALLOWED_ORIGINS=http://127.0.0.1:4320,http://localhost:4320

# Optional operator-managed MSA endpoint and custom checkpoint JSON registry.
WB_MSA_URL=
WB_CHECKPOINTS_FILE=

# Optional existing native Harness installation; LLM/provider configuration lives
# in the service user's default~/.opendde_harness/config.json, not scientific JSON.
# Example interpreter: /opt/opendde/harness/.venv/bin/python
WB_HARNESS_PYTHON=
WB_HARNESS_URL=
WB_HARNESS_TOKEN=
# Map the SAME native compute output root on the workbench and compute hosts.
# Example host: /srv/harness-output; example compute container: /data/output
WB_HARNESS_SHARED_DIR=
WB_HARNESS_REMOTE_DIR=
# Optional native task-root override, read by the external Harness runtime:
# OPENDDE_HARNESS_PROTEIN_DESIGN_ROOT=/srv/harness-tasks
# User-owned CLI/service location; leave unset for ~/.local/share/opendde-workbench.
# WB_HOME=/data/opendde-workbench
# Disable first-start automatic software deployment (models are always opt-in).
WB_AUTO_DEPLOY=0

# Optional DiffSBDD is configured automatically by Installation & components.
# Explicit operator overrides must include the digest of its reviewed native manifest.
# WB_DIFFSBDD_PYTHON=/srv/xdde/environments/diffsbdd/venv/bin/python
# WB_DIFFSBDD_SOURCE=/srv/xdde/environments/diffsbdd/native
# WB_DIFFSBDD_HOME=/srv/xdde/components/x-dde-managed/backends/diffsbdd
# WB_DIFFSBDD_MANIFEST_SHA256=<trusted installed manifest SHA256>
